{
  "permissions": {
    "deny": [
      { "type": "Bash", "pattern": "vercel *" },
      { "type": "Bash", "pattern": "npx vercel *" },
      { "type": "Edit", "pattern": "supabase/migrations/**" },
      { "type": "Read", "pattern": "./.env*" },
      { "type": "Edit", "pattern": "./.env*" },
      { "type": "Edit", "pattern": "app/cockpit/**" },
      { "type": "Edit", "pattern": "app/cockpit-v2/**" },
      { "type": "Edit", "pattern": "app/chat/**" }
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/scripts/claude-session-context.mjs"
          }
        ]
      }
    ]
  }
}
