{
  "regions": ["fra1"],
  "framework": "nextjs",
  "functions": {
    "app/api/marketing/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/briefing-evaluate/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/director-autopilot/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/director-autocompose/route.ts": {
      "maxDuration": 180
    },
    "app/api/cron/bug-agent-index-refresh/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cockpit/bugs/sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cockpit/agent/run",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/briefing-evaluate",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/director-autopilot",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/director-autocompose",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/bug-agent-index-refresh",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/bug-agent-orphan-sweep",
      "schedule": "*/10 * * * *"
    }
  ]
}
